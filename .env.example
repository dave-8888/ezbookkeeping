# Copy this file to ".env" before the first deployment.

APP_PORT=8080
TZ=Asia/Shanghai

# Change this to a long random string before exposing the service to others.
EBK_SECURITY_SECRET_KEY=change-me-before-production

# Update these two values if you deploy behind a domain or reverse proxy.
EBK_SERVER_DOMAIN=localhost
EBK_SERVER_ROOT_URL=http://localhost:8080/
